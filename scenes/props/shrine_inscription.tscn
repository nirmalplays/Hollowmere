[node name="ShrineInscription" type="Node2D" groups=["quest_inscription"]]
script = ExtResource("1")
text = "Carved round the keystone, worn almost smooth:
\"Eight were bound, that none need die.
Eight Lanterns lit against the dark.\"
Below it, scratched in later by another hand: \"We were wrong.\""
radius = 48.0
