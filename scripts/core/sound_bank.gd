class_name SoundBank
extends Resource
## Every sound the game plays, by name. Each name has one or more variations;
## AudioManager picks one at random so repeated sounds (steps, swings) don't drone.
## Generated by tools/audio/import_audio.py.

@export var sounds: Dictionary = {}  ## StringName -> Array[AudioStream]
@export var groups: Dictionary = {}  ## StringName -> &"music" | &"ambient" | &"sfx" | &"ui" | &"spells"


func pick(sound: StringName) -> AudioStream:
	var list: Array = sounds.get(sound, [])
	return null if list.is_empty() else list[randi() % list.size()]


func variations(sound: StringName) -> Array:
	return sounds.get(sound, [])
