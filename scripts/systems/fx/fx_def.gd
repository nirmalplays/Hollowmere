class_name FxDef
extends Resource
## A one-shot effect sprite sheet (grid of frames). Generated by tools/art/import_pixelfx.py.

@export var texture: Texture2D
@export var frame_size: Vector2i = Vector2i(32, 32)
@export var columns: int = 1
@export var frame_count: int = 1
@export var fps: float = 30.0
## Pixel in a frame that sits on the spawn point (the effect's pivot or arc centre).
@export var anchor: Vector2 = Vector2.ZERO
## Rotate the effect to face its direction (slashes, sparks); false for radial ones.
@export var rotates: bool = true
@export var source_id: String = ""  ## pixelfx id it was rendered from

var _frames: SpriteFrames


func frames() -> SpriteFrames:
	if _frames:
		return _frames
	_frames = SpriteFrames.new()
	_frames.set_animation_speed(&"default", fps)
	_frames.set_animation_loop(&"default", false)
	for i in frame_count:
		var atlas := AtlasTexture.new()
		atlas.atlas = texture
		var cell := Vector2(i % columns, i / columns)
		atlas.region = Rect2(cell * Vector2(frame_size), Vector2(frame_size))
		_frames.add_frame(&"default", atlas)
	return _frames
